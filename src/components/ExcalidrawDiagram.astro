---
type Props = {
  scenePath?: string;
  caption?: string;
};

const { scenePath = '/diagrams/tech-stack.excalidraw.json', caption } = Astro.props;
const viewerSrc = `/excalidraw-viewer.html?scene=${encodeURIComponent(scenePath)}`;
---

<figure class="excalidraw-figure" data-excalidraw-figure>
  <div class="excalidraw-figure__stage">
    <iframe
      class="excalidraw-frame"
      src={viewerSrc}
      title="ScottyLabs tech stack diagram"
      loading="lazy"
      referrerpolicy="same-origin"
      tabindex="0"></iframe>
    <button
      type="button"
      class="excalidraw-fullscreen-btn"
      aria-label="View diagram fullscreen"
      aria-pressed="false">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
        <path
          d="M16 3h6v6h-2V5h-4V3zM2 3h6v2H4v4H2V3zm18 16v-4h2v6h-6v-2h4zM4 19h4v2H2v-6h2v4z"></path>
      </svg>
    </button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  function initExcalidrawFullscreen() {
    document.querySelectorAll('[data-excalidraw-figure]').forEach((figure) => {
      const stage = figure.querySelector('.excalidraw-figure__stage');
      const button = figure.querySelector('.excalidraw-fullscreen-btn');
      if (!(stage instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) {
        return;
      }
      if (button.dataset.bound === 'true') {
        return;
      }
      button.dataset.bound = 'true';

      button.addEventListener('click', (event) => {
        event.preventDefault();
        if (document.fullscreenElement === stage) {
          void document.exitFullscreen();
          return;
        }
        void stage.requestFullscreen();
      });
    });
  }

  function syncExcalidrawFullscreen() {
    document.querySelectorAll('.excalidraw-fullscreen-btn').forEach((button) => {
      const stage = button.closest('.excalidraw-figure__stage');
      const iframe = stage?.querySelector('.excalidraw-frame');
      const active = document.fullscreenElement === stage;

      button.setAttribute('aria-pressed', active ? 'true' : 'false');
      button.setAttribute(
        'aria-label',
        active ? 'Exit fullscreen' : 'View diagram fullscreen',
      );

      if (active && iframe instanceof HTMLIFrameElement) {
        iframe.focus();
      }

      if (iframe instanceof HTMLIFrameElement && iframe.contentWindow) {
        iframe.contentWindow.postMessage(
          { type: 'excalidraw-viewport', mode: active ? 'fullscreen' : 'embedded' },
          window.location.origin,
        );
      }
    });
  }

  initExcalidrawFullscreen();
  document.addEventListener('astro:page-load', initExcalidrawFullscreen);
  document.addEventListener('fullscreenchange', syncExcalidrawFullscreen);
</script>
