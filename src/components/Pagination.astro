---
import { Icon } from '@astrojs/starlight/components';
import type { Props } from '@astrojs/starlight/props';
import { repoLinksFromEntry, type RepoPlatform } from '../utils/repos';

const { dir, pagination, entry } = Astro.props;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';
const { slug, links } = repoLinksFromEntry(entry);

const iconByPlatform: Record<RepoPlatform, 'codeberg' | 'github'> = {
	codeberg: 'codeberg',
	github: 'github',
};

const labelByPlatform: Record<RepoPlatform, string> = {
	codeberg: 'Codeberg',
	github: 'GitHub',
};
---

<div class="pagination-links" dir={dir}>
	{
		prev ? (
			<a href={prev.href} rel="prev" class="pagination-link">
				<Icon name={isRtl ? 'right-arrow' : 'left-arrow'} size="1.5rem" />
				<span>
					{Astro.locals.t('page.previousLink')}
					<br />
					<span class="link-title">{prev.label}</span>
				</span>
			</a>
		) : (
			<span class="pagination-spacer" aria-hidden="true" />
		)
	}

	{
		links.length > 0 && (
			<div class="repo-links">
				{
					links.map((link) => (
						<a
							href={link.url}
							class="repo-link"
							target="_blank"
							rel="noopener noreferrer"
							title={`View ${slug} on ${labelByPlatform[link.platform]}`}
						>
							<Icon name={iconByPlatform[link.platform]} size="1.5rem" />
							<span class="sr-only">{labelByPlatform[link.platform]}</span>
						</a>
					))
				}
			</div>
		)
	}

	{
		next ? (
			<a href={next.href} rel="next" class="pagination-link">
				<Icon name={isRtl ? 'left-arrow' : 'right-arrow'} size="1.5rem" />
				<span>
					{Astro.locals.t('page.nextLink')}
					<br />
					<span class="link-title">{next.label}</span>
				</span>
			</a>
		) : (
			<span class="pagination-spacer" aria-hidden="true" />
		)
	}
</div>

<style>
	.pagination-links {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
	}

	.pagination-spacer {
		display: block;
	}

	.pagination-link {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.5rem;
		width: 100%;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 1rem;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		box-shadow: var(--sl-shadow-md);
		overflow-wrap: anywhere;
	}

	.pagination-link[rel='next'] {
		justify-content: end;
		text-align: end;
		flex-direction: row-reverse;
		justify-self: end;
	}

	.pagination-link:hover {
		border-color: var(--sl-color-gray-2);
	}

	.link-title {
		color: var(--sl-color-white);
		font-size: var(--sl-text-2xl);
		line-height: var(--sl-line-height-headings);
	}

	.pagination-link svg {
		flex-shrink: 0;
	}

	.repo-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.repo-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		color: var(--sl-color-gray-2);
		box-shadow: var(--sl-shadow-md);
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.repo-link:hover {
		border-color: var(--sl-color-gray-2);
		color: var(--sl-color-white);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 50rem) {
		.pagination-links {
			grid-template-columns: 1fr;
		}

		.repo-links {
			order: -1;
		}

		.pagination-link[rel='next'] {
			justify-self: stretch;
		}
	}
</style>
