---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
---

<Default><slot /></Default>

<script>
	const LINK_ICON =
		'<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M9.77 12.11a3.5 3.5 0 0 0 0-4.95l-2.83-2.83a3.5 3.5 0 0 0-4.95 4.95l1.06 1.06-1.41 1.41-1.06-1.06a5.5 5.5 0 0 1 7.78-7.78l2.83 2.83a5.5 5.5 0 0 1 0 7.78 5.5 5.5 0 0 1-1.17 1.06l-1.41-1.41a3.5 3.5 0 0 0 1.17-1.06Zm4.46 4.46-1.06-1.06 1.41-1.41 1.06 1.06a3.5 3.5 0 0 0 0-4.95l-2.83-2.83a3.5 3.5 0 0 0-4.95 0 3.5 3.5 0 0 0 0 4.95l1.06 1.06-1.41 1.41-1.06-1.06a5.5 5.5 0 0 1 0-7.78 5.5 5.5 0 0 1 7.78 0l2.83 2.83a5.5 5.5 0 0 1 0 7.78 5.5 5.5 0 0 1-7.78 0Z"/></svg>';

	const CHECK_ICON =
		'<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M9.55 16.45 4.1 11l1.41-1.41 4.04 4.04 9.04-9.04L20 6.59 9.55 16.45Z"/></svg>';

	const HEADING_SELECTOR = '.sl-markdown-content :is(h2, h3, h4, h5, h6)[id]';

	function sectionUrl(id) {
		const url = new URL(window.location.href);
		url.hash = id;
		return url.toString();
	}

	async function copySectionLink(button, heading) {
		const url = sectionUrl(heading.id);
		const label = heading.textContent?.trim() ?? 'section';

		try {
			await navigator.clipboard.writeText(url);
		} catch {
			const input = document.createElement('textarea');
			input.value = url;
			input.setAttribute('readonly', '');
			input.style.position = 'fixed';
			input.style.opacity = '0';
			document.body.appendChild(input);
			input.select();
			document.execCommand('copy');
			input.remove();
		}

		button.dataset.copied = 'true';
		button.innerHTML = CHECK_ICON;
		button.setAttribute('aria-label', `Copied link to ${label}`);

		window.setTimeout(() => {
			delete button.dataset.copied;
			button.innerHTML = LINK_ICON;
			button.setAttribute('aria-label', `Copy link to ${label}`);
		}, 1500);
	}

	function enhanceHeading(heading) {
		if (heading.closest('pre, code') || heading.querySelector('.sl-heading-anchor')) {
			return;
		}

		const wrapper = document.createElement('div');
		wrapper.className = 'sl-heading-wrapper';
		heading.parentNode?.insertBefore(wrapper, heading);
		wrapper.appendChild(heading);

		const label = heading.textContent?.trim() ?? 'section';
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'sl-heading-anchor';
		button.innerHTML = LINK_ICON;
		button.setAttribute('aria-label', `Copy link to ${label}`);
		button.addEventListener('click', (event) => {
			event.preventDefault();
			void copySectionLink(button, heading);
		});

		wrapper.appendChild(button);
	}

	function initHeadingLinks() {
		document.querySelectorAll(HEADING_SELECTOR).forEach((heading) => {
			if (heading.parentElement?.classList.contains('sl-heading-wrapper')) {
				return;
			}
			enhanceHeading(heading);
		});
	}

	initHeadingLinks();
	document.addEventListener('astro:page-load', initHeadingLinks);

	const EXPAND_ICON =
		'<svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M16 3h6v6h-2V5h-4V3zM2 3h6v2H4v4H2V3zm18 16v-4h2v6h-6v-2h4zM4 19h4v2H2v-6h2v4z"/></svg>';

	function enhanceMermaidDiagrams() {
		document
			.querySelectorAll('.sl-markdown-content pre.mermaid[data-processed]')
			.forEach((diagram) => {
				if (diagram.querySelector('.sl-mermaid-fullscreen-btn')) {
					return;
				}

				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'sl-mermaid-fullscreen-btn';
				button.innerHTML = EXPAND_ICON;
				button.setAttribute('aria-label', 'View diagram fullscreen');
				button.setAttribute('aria-pressed', 'false');
				button.addEventListener('click', (event) => {
					event.preventDefault();
					if (document.fullscreenElement === diagram) {
						void document.exitFullscreen();
						return;
					}
					void diagram.requestFullscreen();
				});

				diagram.appendChild(button);
			});
	}

	function syncMermaidFullscreenButtons() {
		document.querySelectorAll('.sl-mermaid-fullscreen-btn').forEach((button) => {
			const diagram = button.closest('pre.mermaid');
			const active = document.fullscreenElement === diagram;
			button.setAttribute('aria-pressed', active ? 'true' : 'false');
			button.setAttribute('aria-label', active ? 'Exit fullscreen' : 'View diagram fullscreen');
		});
	}

	function initMermaidFullscreen() {
		enhanceMermaidDiagrams();
		syncMermaidFullscreenButtons();
	}

	initMermaidFullscreen();
	document.addEventListener('astro:page-load', initMermaidFullscreen);
	document.addEventListener('fullscreenchange', syncMermaidFullscreenButtons);

	const mermaidObserver = new MutationObserver(() => {
		enhanceMermaidDiagrams();
	});
	document.querySelectorAll('.sl-markdown-content').forEach((content) => {
		mermaidObserver.observe(content, {
			childList: true,
			subtree: true,
			attributes: true,
			attributeFilter: ['data-processed'],
		});
	});
</script>
