---
/**
 * Sidebar wrapper without Starlight's open/closed or scroll persistence.
 * The docs hub sidebar is always fully expanded and identical on every page.
 */
---

<script is:inline>
	(() => {
		try {
			sessionStorage.removeItem('sl-sidebar-state');
			sessionStorage.removeItem('sl-sidebar-scroll');
		} catch {}
	})();
</script>

<slot />
