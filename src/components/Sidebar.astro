---
import type { Props } from '@astrojs/starlight/props';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarSublist from './SidebarSublist.astro';
import SidebarPersister from './SidebarPersister.astro';

const { sidebar } = Astro.props;
---

<SidebarPersister {...Astro.props}>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter {...Astro.props} />
</div>

<script is:inline>
	(() => {
		const resetSidebar = () => {
			try {
				sessionStorage.removeItem('sl-sidebar-state');
				sessionStorage.removeItem('sl-sidebar-scroll');
			} catch {}

		const scroller = document.getElementById('starlight__sidebar');
		if (scroller) {
			const current = scroller.querySelector('a[aria-current="page"]');
			if (current) {
				current.scrollIntoView({ block: 'nearest', inline: 'nearest' });
			} else {
				scroller.scrollTop = 0;
			}
		}
		};

		resetSidebar();

		// Back/forward cache can restore an old sidebar DOM (e.g. Welcome-only).
		window.addEventListener('pageshow', (event) => {
			if (event.persisted) {
				resetSidebar();
				location.reload();
			}
		});
	})();
</script>
