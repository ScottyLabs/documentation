---
import { ScalarComponent } from '@scalar/astro';

export async function getStaticPaths() {
  // This will be populated by the build script when OpenAPI projects are added
  // For now, return empty array to allow build to succeed
  return [];
}

// Get project slug from URL params
const { slug } = Astro.params;

// Check if OpenAPI spec exists for this project
const specPath = `/specs/${slug}.json`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{slug} API Reference - ScottyLabs Docs</title>
  </head>
  <body>
    <ScalarComponent 
      spec={{
        url: specPath
      }}
      configuration={{
        theme: 'default',
      }}
    />
  </body>
</html>
